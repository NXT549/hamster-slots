{
  // TypeScript settings for the game's code (src/). `npm run typecheck` checks it;
  // Vite builds it. tsconfig.logic.json checks src/logic on its own, with no
  // browser types, so the game rules can never use the page (rule 1).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],

    // Strict: TypeScript checks everything it can (no silent "any", null checks …).
    "strict": true,

    // Vite and Vitest turn the .ts files into JavaScript; TypeScript only checks.
    "noEmit": true,
    // Imports name the real file, e.g. './machine.ts', so Node can run the
    // logic straight from the .ts files too (the simulator and the tools).
    "allowImportingTsExtensions": true,
    // Only TypeScript that can be removed to get plain JavaScript (no enums etc.),
    // so Node's built-in "strip the types" works on these files.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
